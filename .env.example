# Used by docker-compose.yml only (local development).
# Copy to .env and choose your own values – never commit .env.
# Use letters and digits only (or URL-encode special characters).
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# Optional: host port for MongoDB Compass if 27017 is already taken on your PC
MONGO_HOST_PORT=27017
# Optional: host port for the API if 3000 is already taken
API_HOST_PORT=3000
