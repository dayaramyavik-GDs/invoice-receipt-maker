<?xml version='1.0' encoding='utf-8'?>
<widget id="com.yourname.invoicemaker" version="0.1.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Invoice Maker</name>
  <description>Offline-first invoices and receipts for sole traders.</description>
  <author email="you@example.com">Your Name</author>
  <content src="index.html" />

  <!-- Network requests allowed only to the API (dev tunnel + production) -->
  <access origin="https://api.example.com" />
  <access origin="https://*.trycloudflare.com" />

  <allow-intent href="https://*/*" />
  <allow-intent href="mailto:*" />
  <allow-intent href="tel:*" />

  <platform name="android">
    <preference name="android-minSdkVersion" value="24" />
    <preference name="AndroidPersistentFileLocation" value="Internal" />
  </platform>
</widget>
