<?xml version='1.0' encoding='utf-8'?>
<widget id="com.dayaramyavik.invoicemaker" version="0.1.0"
        xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Invoice Maker</name>
  <description>Offline-first invoices and receipts for sole traders.</description>
  <author href="https://github.com/dayaramyavik-GDs">dayaramyavik-GDs</author>
  <content src="index.html" />

  <!-- The sync API origin is added to <access> and the CSP at build time from api.config.json -->
  <hook type="after_prepare" src="scripts/apply-api-origin.js" />

  <allow-intent href="https://*/*" />
  <allow-intent href="mailto:*" />
  <allow-intent href="tel:*" />

  <platform name="android">
    <preference name="android-minSdkVersion" value="24" />
    <preference name="AndroidPersistentFileLocation" value="Internal" />
  </platform>
</widget>
