NODE_ENV=development
PORT=3000

# Outside Docker: mongodb://<user>:<password>@localhost:27017/invoice_maker?authSource=admin
# Atlas:          mongodb+srv://<user>:<password>@<cluster-host>/invoice_maker?retryWrites=true&w=majority
# (Inside Docker Compose this is overridden automatically.)
MONGODB_URI=

# Generate each with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# Cordova Android origin, and `cordova serve` for browser testing
CORS_ORIGINS=https://localhost,http://localhost:8000
